# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Prediction cache: large, regenerable, keyed by prompt + model digest.
# Cache *statistics* are recorded in each run manifest instead.
cache/

# Raw dataset files and the prepared splits. data/manifests/ IS tracked: it holds
# the source, licence, counts, every case ID and every file hash, so the splits
# below are reproducible from it with `python scripts/prepare_data.py`. Keeping
# them untracked also keeps test labels out of the repository before the freeze.
data/processed/
data/raw/

# Run outputs are immutable evidence. Prediction and timing logs are tracked
# (about 1.2 MB in total on 16 Oct) so scripts/reproduce_metrics.py can
# recompute every result from a fresh clone.

# Secrets: free-API keys for the Architect's planning calls only.
.env
*.key
secrets.json

# Local model weights (GGUF). Large and re-downloadable; the Modelfile that
# registers them IS tracked so the setup is reproducible.
data/models/*.gguf

# Background job logs
logs/

# Files the diy scripts write when you run them
diy/my_*
diy/__pycache__/
